<?xml version="1.0"?>
<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="dolphin" version="52">
    <MenuBar>
        <Menu name="file">
            <Action name="new_menu" />
            <Action name="file_new" />
            <Action name="new_tab" />
            <Action name="new_tab_from_clipboard" />
            <Action name="file_close" />
            <Action name="undo_close_tab" />
            <Separator/>
            <Action name="add_to_places" />
            <Separator/>
            <Action name="renamefile" />
            <Action name="duplicate" />
            <Action name="color_label" />
            <Action name="movetotrash" />
            <Action name="deletefile" />
            <Separator/>
            <Action name="show_target" />
            <Separator/>
            <Menu name="notes_menu" icon="document-new">
                <text context="@title:menu">Notes and To-Dos</text>
                <Action name="new_note" />
                <Action name="new_todo" />
                <Action name="toggle_todo_done" />
            </Menu>
            <Action name="paste_clipboard_as_file" />
            <Separator/>
            <Action name="properties" />
        </Menu>
        <Menu name="edit">
            <Action name="edit_cut" />
            <Action name="edit_copy" />
            <Action name="copy_location" />
            <Action name="edit_paste" />
            <Separator />
            <Action name="show_filter_bar" />
            <Action name="edit_find" />
            <Separator />
            <Action name="toggle_selection_mode" />
            <Action name="copy_to_inactive_split_view" />
            <Action name="move_to_inactive_split_view" />
            <Action name="edit_select_all" />
            <Action name="invert_selection" />
            <Action name="select_by_pattern" />
            <Action name="deselect_by_pattern" />
        </Menu>
        <Menu name="view">
            <Action name="view_zoom_in"/>
            <Action name="view_zoom_reset"/>
            <Action name="view_zoom_out"/>
            <Separator/>
            <Action name="sort" />
            <Action name="group_by" />
            <Action name="view_mode" />
            <Action name="additional_info" />
            <Action name="show_preview" />
            <Action name="show_hidden_files" />
            <Action name="act_as_admin" />
            <Separator/>
            <Action name="restore_view_settings_default" />
            <Action name="view_properties" />
            <Separator/>
            <Action name="commander_layouts" />
            <Action name="file_views" />
            <Action name="color_theme" />
            <Menu name="appearance_menu" icon="preferences-desktop-theme">
                <text context="@title:menu">Appearance and Behavior</text>
                <Action name="toggle_columns_view" />
                <Action name="lock_column_resizing" />
                <Action name="names_only" />
                <Action name="hide_columns_when_narrow" />
                <Action name="age_stripes" />
                <Action name="folders_sorted_by_name" />
                <Action name="item_scrolling" />
                <Separator/>
                <Action name="reload_theme" />
                <Action name="center_window" />
            </Menu>
            <Separator/>
            <Action name="redisplay" />
            <Action name="stop" />
            <Separator/>
            <Action name="panels" />
            <Action name="show_notifications_panel" />
            <Menu name="location_bar" icon="edit-select-text">
                <text context="@title:menu">Location Bar</text>
                <Action name="editable_location" />
                <Action name="replace_location" />
            </Menu>
        </Menu>
        <Menu name="sides_menu">
            <text context="@title:menu">&amp;Sides</text>
            <Action name="split_view_menu" />
            <Action name="move_to_tabs_split_view" />
            <Action name="popout_split_view" />
            <Action name="focus_inactive_split_view" />
            <Separator/>
            <Action name="sync_browsing" />
            <Action name="mirror_to_other_side" />
            <Action name="swap_sides" />
            <Action name="sync_to_other_side" />
            <Action name="compare_directories" />
            <Action name="unpack_to_other_side" />
            <Separator/>
            <Action name="folder_hotlist" />
            <Action name="workspaces_menu" />
            <Action name="split_stash" />
        </Menu>
        <Menu name="go">
            <Action name="bookmarks" />
            <Action name="closed_tabs" />
        </Menu>
        <Menu name="tools">
            <Action name="open_preferred_search_tool" />
            <Action name="open_terminal" />
            <Action name="open_terminal_here" />
            <Action name="manage_disk_space" />
            <Action name="compare_files" />
            <Action name="change_remote_encoding" />
            <Separator/>
            <Action name="quick_view" />
            <Action name="show_checksum" />
            <Action name="batch_rename" />
            <Action name="find_duplicates" />
            <Action name="folder_sizes" />
            <Action name="convert_images" />
            <Action name="pack_selection" />
            <Separator/>
            <Action name="open_with_dialog" />
            <Action name="run_with_arguments" />
            <Action name="scripts_menu" />
            <Separator/>
            <Action name="open_terminal_as_administrator" />
            <Action name="restart_as_administrator" />
            <Separator/>
            <Action name="recent_notifications" />
            <Action name="queue_jobs" />
            <Action name="keep_running_when_closed" />
        </Menu>
        <Menu name="settings">
        </Menu>
    </MenuBar>
    <State name="new_file" >
        <disable>
            <Action name="edit_undo" />
            <Action name="edit_redo" />
            <Action name="edit_cut" />
            <Action name="renamefile" />
            <Action name="movetotrash" />
            <Action name="deletefile" />
            <Action name="invert_selection" />
            <Separator/>
            <Action name="go_back" />
            <Action name="go_forward" />
        </disable>
    </State>
    <State name="has_selection" >
        <enable>
            <Action name="invert_selection" />
        </enable>
    </State>
    <State name="has_no_selection" >
        <disable>
            <Action name="delete_shortcut" />
            <Action name="invert_selection" />
        </disable>
    </State>
    <ActionProperties scheme="Default">
        <Action priority="0" name="go_back"/>
        <Action priority="0" name="go_forward"/>
        <Action priority="0" name="go_up"/>
        <Action priority="0" name="go_home"/>
        <Action priority="0" name="stop"/>
        <Action priority="0" name="icons"/>
        <Action priority="0" name="compact"/>
        <Action priority="0" name="details"/>
        <Action priority="0" name="columns"/>
        <Action priority="0" name="view_mode" />
        <Action priority="0" name="view_settings" />
        <Action priority="0" name="view_zoom_in"/>
        <Action priority="0" name="view_zoom_reset"/>
        <Action priority="0" name="view_zoom_out"/>
        <Action priority="0" name="edit_cut"/>
        <Action priority="0" name="edit_copy"/>
        <Action priority="0" name="edit_paste"/>
        <Action priority="0" name="toggle_search"/>
        <Action priority="0" name="toggle_filter"/>
    </ActionProperties>
</gui>
